{
  "name": "@mr-hope/tsconfig",
  "version": "0.0.4",
  "description": "Modern and strict tsconfig presets for Bundler, Node.js, and Web environments.",
  "keywords": [
    "bundler",
    "config",
    "node20",
    "preset",
    "tsconfig",
    "typescript",
    "vite"
  ],
  "license": "MIT",
  "author": "Mr.Hope",
  "repository": {
    "url": "https://github.com/Mister-Hope/tsconfig"
  },
  "files": [
    "base.json",
    "bundler.json",
    "check.json",
    "dts.json",
    "node.json",
    "web.json"
  ],
  "type": "module",
  "exports": {
    "./base.json": "./base.json",
    "./bundler.json": "./bundler.json",
    "./check.json": "./check.json",
    "./dts.json": "./dts.json",
    "./node.json": "./node.json",
    "./web.json": "./web.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxfmt"
  },
  "devDependencies": {
    "oxfmt": "0.67.0"
  },
  "peerDependencies": {
    "typescript": ">=5.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.22.0 || ^24.16.0 || ^26.3.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
